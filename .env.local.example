# ============================================
# 카카오 지도 (필수 · Phase 1)
# ============================================
NEXT_PUBLIC_KAKAO_APP_KEY=your_kakao_javascript_key_here
KAKAO_REST_API_KEY=your_kakao_rest_api_key_here

# ============================================
# 공공데이터포털 / 정부 API (공공 안전정보 동기화 · 서버 전용)
# https://www.data.go.kr/
# - POST /api/admin/public-safety/sync 에서만 사용
# - NEXT_PUBLIC_ 접두어를 붙이지 마세요.
# ============================================
GOV24_API_KEY=your_data_go_kr_service_key_here

# ============================================
# 지진해일 대피지구 (서버 전용)
# 권장 경로: data.go.kr OpenAPI (즉시 승인 + 좌표 포함)
#   https://www.data.go.kr/data/15138870/openapi.do
#   - 활용신청 → "일반 인증키(Decoding)" → SAFETYDATA_API_KEY
#   - "API 명세" 의 요청 URL (host/경로까지만, query 제외) → SAFETYDATA_TSUNAMI_API_URL
# 대체 경로: safetydata.go.kr (1~2일 승인 대기)
#   https://www.safetydata.go.kr/  (DSSP-IF-10164 등)
#   - 비워두면 기본 추정 URL(DSSP-IF-10164) 사용
# 사용처: POST /api/admin/disasters/tsunami-evacuation/sync
#         scripts/sync-tsunami-evacuation.ts
# 주의: NEXT_PUBLIC_ 접두어 절대 금지 (서버 전용 키)
# ============================================
SAFETYDATA_API_KEY=your_service_key_here
# SAFETYDATA_TSUNAMI_API_URL=https://apis.data.go.kr/1741000/EmgncyEvcltnPlaceData/getEmgncyEvcltnPlaceData
# 지진 옥외대피소 (safetydata.go.kr DSSP-IF-00103) — 엔드포인트가 다르면만 지정
# SAFETYDATA_EARTHQUAKE_SHELTER_API_URL=https://www.safetydata.go.kr/V2/api/DSSP-IF-00103

# ============================================
# Supabase (필수 · Phase 1)
# https://supabase.com/dashboard/project/_/settings/api
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ============================================
# 네이버 검색 API (Phase 2 · 무료 25,000회/월)
# https://developers.naver.com/apps/
# ============================================
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ============================================
# OpenAI (Phase 3 · 유료, 기본 비활성화)
# https://platform.openai.com/api-keys
# ============================================
OPENAI_API_KEY=

# ============================================
# Tavily Search (Phase 2/3 · 영문/글로벌, 선택)
# https://tavily.com/
# ============================================
TAVILY_API_KEY=

# ============================================
# OpenStreetMap Nominatim (영어 모드 지오코딩·검색, 선택)
# https://operations.osmfoundation.org/policies/nominatim/
# 비우면 기본 User-Agent 문자열이 사용됩니다.
# ============================================
# NOMINATIM_USER_AGENT=YourApp/1.0 (contact@example.com)

# ============================================
# 지역 설정
# ============================================
NEXT_PUBLIC_IS_KOREA=true

# ============================================
# 개발 전용 (선택 · 테스트 데이터 삭제)
# ============================================
# ADMIN_DELETE_SECRET 을 설정하면 DELETE /api/accidents/:id 요청에
# 헤더 `x-admin-delete-secret: <동일값>` 이 있을 때 로그인 없이 삭제 가능합니다.
ADMIN_DELETE_SECRET=
# true 이면 사고 상세 모달에 비밀번호 입력란이 보입니다.
NEXT_PUBLIC_ENABLE_DEV_DELETE=false

# ============================================
# 관리자 접근 (임시 · 관리자 권한 구조 완성 전)
# ============================================
# 쉼표로 구분된 이메일 목록. /admin/public-safety 및 관리자 동기화 API 접근에 사용됩니다.
# 예: ADMIN_EMAILS=admin@example.com,ops@example.com
ADMIN_EMAILS=

# ============================================
# Feature Flags (선택 · 기능별 토글)
# Phase 1 기본값으로 충분, 활성화 시 'true' 입력
# ============================================
FEATURE_USER_REGISTRATION=true
FEATURE_NEWS_SEARCH=false
FEATURE_WIKI_IMPORT=false
FEATURE_AI_ENABLED=false
FEATURE_TIMELINE=false
FEATURE_MODERATION=false
FEATURE_MEDIA_UPLOAD=false
FEATURE_GLOBAL_MODE=false

# ============================================
# 검색 Provider 선택 (Phase 2 · "naver" | "tavily" | "daum")
# ============================================
SEARCH_PROVIDER=naver

# ============================================
# 배치 적재 npm run import:batch (선택)
# Supabase 마이그레이션으로 external_source_id 컬럼 적용 후 사용.
# ============================================
# 스크립트에서 뉴스 소스를 켤 때 (FEATURE_NEWS_SEARCH=false 여도 동작)
IMPORT_FORCE_NEWS=1
